TELEGRAM_BOT_TOKEN=123456:replace-me
# Set this after running the bot once in learn-owner mode (see below).
TELEGRAM_OWNER_CHAT_ID=123456789
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/auto
# Optional: a structured decision model (OpenRouter's Decisions API, e.g.
# typesafe/jev-1.13) used for fast capability selection. When set, the
# router asks this model which capability matches first, and only falls
# back to LLM_MODEL to extract parameters when a capability is picked.
# Leave empty to route with LLM_MODEL alone, as before.
STRUCTURED_DECISION_MODEL=
# How free text is routed. The three decision-* values require
# STRUCTURED_DECISION_MODEL and are rejected at startup without it.
#   model            LLM_MODEL selects the capability and fills parameters
#   decision-select  decision model selects, LLM_MODEL fills parameters
#   decision-extract decision model also fills the parameters it can,
#                    LLM_MODEL fills the rest
#   decision-only    decision model does everything, LLM_MODEL is never called
#                    (commands it cannot fill reply "use the explicit form")
ROUTING_STRATEGY=model
# Per-parameter confidence below which extraction falls back to LLM_MODEL.
STRUCTURED_DECISION_MIN_CONFIDENCE=0.5
# Reply to every free-text message with the models, timings and cost used.
ROUTING_VERBOSE=false
ROUTING_CONFIDENCE_THRESHOLD=0.6
REPLY_TIMEOUT_SECONDS=10
LLM_RATE_LIMIT_PER_MINUTE=20
NOTIFIER_RATE_LIMIT_PER_MINUTE=10
SERVICE_DISPLAY_NAMES={"sniper-bot": "Sniper", "home-automation": "HA"}

# --- Learn-owner mode ---
# Leave TELEGRAM_OWNER_CHAT_ID unset on the first run.
# The bot will print a one-time token to stdout, e.g.:
#   [telegram-proxy] Learn-owner mode: send the token  a1b2c3d4  to this bot to register as the owner.
# Send that exact token as a Telegram message to your bot.
# The bot replies with your chat id, stores it in Redis, and becomes fully active immediately —
# no restart required.
# Optionally set TELEGRAM_OWNER_CHAT_ID to that value to make it permanent without Redis
# (e.g. if you ever flush Redis or deploy to a new environment).
